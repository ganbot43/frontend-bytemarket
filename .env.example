# Copia este archivo a .env y rellena los valores.
# El .env NO se versiona (está en .gitignore).

# ── API Gateway ──────────────────────────────────────────
# server/api/[...path].ts reenvía aquí todo /api/**
NUXT_API_GATEWAY_URL=http://localhost:8085

# ── Sesión sellada (nuxt-auth-utils) ─────────────────────
# Cadena larga y aleatoria; cámbiala en producción.
NUXT_SESSION_PASSWORD=

# ── reCAPTCHA ────────────────────────────────────────────
G_RECAPTCHA_SITE_KEY=
G_RECAPTCHA_SECRET_KEY=

# ── SMTP (formularios del landing) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="ByteMarket S.A.C. <info@bytemarket.com.pe>"

# ── Google Analytics ─────────────────────────────────────
GTAG_ID=

# ── Marca ────────────────────────────────────────────────
NUXT_PUBLIC_APP_NAME=ByteMarket S.A.C.
NUXT_PUBLIC_COMPANY_NAME="ByteMarket S.A.C."
NUXT_PUBLIC_SITE_NAME=ByteMarket
NUXT_PUBLIC_SITE_URL=https://bytemarket.pe
NUXT_PUBLIC_WHATSAPP="+51923821520"
